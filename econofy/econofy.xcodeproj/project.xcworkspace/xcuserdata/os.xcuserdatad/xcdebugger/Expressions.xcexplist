<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "specialized AppDelegate.application(_:didFinishLaunchingWithOptions:):AppDelegate.swift">
         <PersistentStrings>
            <PersistentString
               value = "test">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "CustomDotsIndicator.setupDots():OnboardingViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "numberOfDots">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "static UIFont.Poppins.fixed(_:size:):+PoppinsTextFont.swift">
      </ContextState>
      <ContextState
         contextName = "closure #1 in closure #1 in MainViewPresenter.viewIsReady():MainViewPresenter.swift">
         <PersistentStrings>
            <PersistentString
               value = "Memory.shared.hasCompletedOnboarding">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "FontRegistrar.registerFontIfNeeded(named:):UtilsFont.swift">
         <PersistentStrings>
            <PersistentString
               value = "registeredFonts">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
